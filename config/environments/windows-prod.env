# Packaged Windows profile. The Electron shell and its sibling daemon share
# this local user data root so the portable bundle behaves like macOS.
WORKASS_PROFILE=prod
WORKASS_APP_NAME=Workass
WORKASS_BUNDLE_ID=com.workass.app
WORKASS_DAEMON_PORT=80
WORKASS_DAEMON_BIND=lan
WORKASS_VIEW_PORT=8798
WORKASS_LAUNCHD_LABEL=com.workass.daemon
WORKASS_DATA_ROOT="${LOCALAPPDATA}/Workass"
WORKASS_LOG_ROOT="${LOCALAPPDATA}/Workass/logs"
WORKASS_UPDATE_CHANNEL=github
