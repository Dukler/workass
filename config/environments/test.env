# Automated tests must override WORKASS_TEST_ROOT with a fresh temporary
# directory. Network listeners use OS-assigned ports rather than shared ports.
WORKASS_PROFILE=test
WORKASS_APP_NAME="Workass Test"
WORKASS_BUNDLE_ID=com.workass.test
WORKASS_DAEMON_PORT=0
WORKASS_DAEMON_BIND=localhost
WORKASS_VIEW_PORT=0
WORKASS_LAUNCHD_LABEL=com.workass.daemon.test
WORKASS_DATA_ROOT="${WORKASS_TEST_ROOT}"
WORKASS_LOG_ROOT="${WORKASS_DATA_ROOT}/logs"
