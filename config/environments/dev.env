# Workass development profile. All mutable data stays inside the repository's
# ignored .dev tree so it cannot contaminate production chats or credentials.
WORKASS_PROFILE=dev
WORKASS_APP_NAME="Workass Dev"
WORKASS_BUNDLE_ID=com.workass.dev
WORKASS_DAEMON_PORT=18788
WORKASS_DAEMON_BIND=localhost
WORKASS_VIEW_PORT=8799
WORKASS_LAUNCHD_LABEL=com.workass.daemon.dev
WORKASS_DATA_ROOT="${WORKASS_REPO_ROOT}/.dev/profiles/default"
WORKASS_LOG_ROOT="${WORKASS_DATA_ROOT}/logs"
